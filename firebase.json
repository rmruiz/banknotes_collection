{
  "hosting": {
    "public": "web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|gif|png|css|js|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=7200, must-revalidate"
          }
        ]
      }
    ]
  }
}
